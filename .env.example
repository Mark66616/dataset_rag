# MinerU / 模型缓存
MINERU_MODEL_SOURCE=modelscope
MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=E:/ai_models/modelscope_cache
HF_HOME=E:/ai_models/huggingface_cache
MD_ROOT_DIR=./temp-files/

# 大模型与视觉模型（兼容 OpenAI API）
LLM_DEFAULT_MODEL=qwen-flash
VL_MODEL=qwen3-vl-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_TEMPERATURE=0.1

# BGE-M3 向量模型
BGE_M3_PATH=E:/ai_models/modelscope_cache/models/models/BAAI--bge-m3/snapshots/master
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=0
ITEM_NAME_DIAG=1
EMBEDDING_DIM=1024

# Milvus
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names

# Neo4j（IP 已脱敏；使用 Docker Compose 时可改为 bolt://localhost:7687）
NEO4J_URI=bolt://your-neo4j-host:7687
NEO4J_DATABASE=neo4j
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password

# MongoDB（IP 已脱敏；使用 Docker Compose 时可改为 mongodb://localhost:27017）
MONGO_URL=mongodb://your-mongodb-host:27017
MONGO_DB_NAME=kb002

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=/upload-images
MINIO_SECURE=False

# BGE 重排模型
BGE_RERANKER_LARGE=E:/ai_models/modelscope_cache/models/rerank/models/BAAI--bge-reranker-large/snapshots/master
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# 百炼 MCP WebSearch
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
MCP_DASHSCOPE_BASE_URL_STREAMABLE=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/mcp

# MinerU API
MINERU_API_TOKEN=your-mineru-api-key
MINERU_BASE_URL=https://mineru.net/api/v4

# 日志
LOG_CONSOLE_ENABLE=True
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=True
LOG_FILE_LEVEL=ERROR
LOG_FILE_RETENTION=7 days

# Docker 部署（可选）
# 构建时 torch 下载源：GPU 默认（cu128）；CPU 环境改为 https://download.pytorch.org/whl/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu128
# 构建时 PyPI 源：国内可改为 https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple
# Docker 模型缓存目录（挂载到容器 /models）
MODELS_CACHE_DIR=./models_cache
# 注意：docker-compose.yml 中应用服务的 BGE_DEVICE/BGE_FP16/BGE_RERANKER_* 已硬编码为 GPU(cuda:0)，
# 不受本文件影响；CPU 部署请按 docker-compose.yml 内注释修改。
